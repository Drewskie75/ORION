{
  "name": "orion-backend",
  "version": "1.0.0",
  "description": "Orion RWA Protocol Indexer & REST/WebSocket API Service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/db', {recursive:true}); fs.copyFileSync('src/db/schema.sql', 'dist/db/schema.sql');\"",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "db:migrate": "ts-node src/db/migrate.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@pythnetwork/client": "^2.20.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.95.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
